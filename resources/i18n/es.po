msgid "euSKlid"
msgstr "euSKlid"

msgid "euSKlid planar sketching workbench for FreeCAD"
msgstr "Banco de trabajo de dibujo plano euSKlid para FreeCAD"

msgid "Sketch"
msgstr "Boceto"

msgid "Lines"
msgstr "Líneas"

msgid "Circles"
msgstr "Círculos"

msgid "Path"
msgstr "Contorno"

msgid "New Sketch"
msgstr "Nuevo boceto"

msgid "Create a new euSKlid sketch"
msgstr "Crear un nuevo boceto euSKlid"

msgid "2 Anchors"
msgstr "2 anclas"

msgid "Create an infinite line through 2 anchors"
msgstr "Crear una línea infinita a través de 2 anclas"

msgid "// U"
msgstr "// U"

msgid "Create lines parallel to U. Positive values go toward +V."
msgstr "Crear líneas paralelas a U. Los valores positivos van hacia +V."

msgid "// V"
msgstr "// V"

msgid "Create lines parallel to V. Positive values go toward +U."
msgstr "Crear líneas paralelas a V. Los valores positivos van hacia +U."

msgid "// Ref"
msgstr "// Ref"

msgid "Pick a reference, see positive-side arrow, then enter signed distances."
msgstr "Seleccionar una referencia, ver la flecha del lado positivo y luego introducir distancias con signo."

msgid "Grid"
msgstr "Cuadrícula"

msgid "Create a multi-series grid centered on a picked point"
msgstr "Crear una cuadrícula multi-serie centrada en un punto seleccionado"

msgid "Center / Radius"
msgstr "Centro / Radio"

msgid "Construction circle by center and radius"
msgstr "Círculo de construcción por centro y radio"

msgid "Center / Anchor"
msgstr "Centro / Ancla"

msgid "Construction circle by center and anchor (point, line tangency, circle tangency)"
msgstr "Círculo de construcción por centro y ancla (punto, tangencia línea, tangencia círculo)"

msgid "3 Anchors"
msgstr "3 anclas"

msgid "Construction circle through 3 anchors"
msgstr "Círculo de construcción a través de 3 anclas"

msgid "2 Anchors / Radius"
msgstr "2 anclas / Radio"

msgid "Construction circle through 2 anchors with given radius"
msgstr "Círculo de construcción a través de 2 anclas con radio dado"

