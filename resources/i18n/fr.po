msgstr "Survol"

msgid "Markers"
msgstr "Marqueurs"

msgid "Construction"
msgstr "Construction"

msgid "Highlight"
msgstr "Surbrillance"

msgid "Current path"
msgstr "Contour courant"

msgid "Candidate path"
msgstr "Contour candidat"

msgid "Closed path"
msgstr "Contour fermé"

