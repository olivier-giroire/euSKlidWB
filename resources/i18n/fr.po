msgstr "Taille (px)"

msgid "Arrow size"
msgstr "Taille flèche"

msgid "Thickness"
msgstr "Épaisseur"

msgid "Direction Arrows"
msgstr "Flèches de direction"

msgid "Color"
msgstr "Couleur"

msgid "Transparency"
msgstr "Transparence"

