msgstr "Messages console"

msgid "Help messages"
msgstr "Messages d'aide"

msgid "You can't touch this !"
msgstr "Sélection inutilisable !"

msgid "Expected: reference line"
msgstr "Attendu : droite de référence"

msgid "Expected: snap point â free point"
msgstr "Expected: snap point â free point"

msgid "Expected: snap point â tangent circle â circle â free point"
msgstr "Expected: snap point â tangent circle â circle â free point"

msgid "Expected: snap point â tangent anchor â line â circle â free point"
msgstr "Expected: snap point â tangent anchor â line â circle â free point"

msgid "Expected: snap point → free point"
msgstr "Attendu : point d'accroche → point libre"

msgid "Expected: snap point → tangent circle → circle → free point"
msgstr "Attendu : point d'accroche → cercle tangent → cercle → point libre"

msgid "Expected: snap point → tangent anchor → line → circle → free point"
msgstr "Attendu : point d'accroche → ancre tangente → ligne → cercle → point libre"

msgid "Open Sketch"
msgstr "Ouvrir sketch"

msgid "Open an existing euSKlid sketch from the active document"
msgstr "Ouvrir un sketch euSKlid existant du document actif"

msgid "No active document."
msgstr "Aucun document actif."

msgid "No euSKlid sketch found in the active document."
msgstr "Aucun sketch euSKlid trouvé dans le document actif."

msgid "Reopen contour in active sketch"
msgstr "Réouvrir le contour dans le sketch actif"

msgid "Re-export the closed euSKlid contour into the active Sketcher sketch, replacing only the previous euSKlid export"
msgstr "Réexporter le contour euSKlid fermé dans le sketch Sketcher actif, en remplaçant seulement l’export euSKlid précédent"
