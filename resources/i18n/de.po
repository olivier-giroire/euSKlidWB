msgstr "Neue Skizze"

msgid "Create a new euSKlid sketch"
msgstr "Eine neue euSKlid-Skizze erstellen"

msgid "2 Anchors"
msgstr "2 Anker"

msgid "Create an infinite line through 2 anchors"
msgstr "Eine unendliche Linie durch 2 Anker erstellen"

