msgid "euSKlid"
msgstr "euSKlid"

msgid "euSKlid planar sketching workbench for FreeCAD"
msgstr "euSKlid Arbeitsbereich für planare Skizzen in FreeCAD"

msgid "Sketch"
msgstr "Skizze"

msgid "Lines"
msgstr "Linien"

msgid "Circles"
msgstr "Kreise"

