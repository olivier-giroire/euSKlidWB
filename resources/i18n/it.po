msgid "euSKlid"
msgstr "euSKlid"

msgid "euSKlid planar sketching workbench for FreeCAD"
msgstr "Ambiente di disegno planare euSKlid per FreeCAD"

msgid "Sketch"
msgstr "Schizzo"

msgid "Lines"
msgstr "Linee"

msgid "Circles"
msgstr "Cerchi"

msgid "Path"
msgstr "Contorno"

msgid "New Sketch"
msgstr "Nuovo schizzo"

msgid "Create a new euSKlid sketch"
msgstr "Creare un nuovo schizzo euSKlid"

msgid "2 Anchors"
msgstr "2 ancore"

msgid "Create an infinite line through 2 anchors"
msgstr "Creare una linea infinita attraverso 2 ancore"

msgid "// U"
msgstr "// U"

msgid "Create lines parallel to U. Positive values go toward +V."
msgstr "Creare linee parallele a U. I valori positivi vanno verso +V."

msgid "// V"
msgstr "// V"

msgid "Create lines parallel to V. Positive values go toward +U."
msgstr "Creare linee parallele a V. I valori positivi vanno verso +U."

msgid "// Ref"
msgstr "// Rif"

msgid "Pick a reference, see positive-side arrow, then enter signed distances."
msgstr "Selezionare un riferimento, vedere la freccia del lato positivo, quindi inserire le distanze con segno."

msgid "Grid"
msgstr "Griglia"

msgid "Create a multi-series grid centered on a picked point"
msgstr "Creare una griglia multi-serie centrata su un punto selezionato"

msgid "Center / Radius"
msgstr "Centro / Raggio"

msgid "Construction circle by center and radius"
msgstr "Cerchio di costruzione per centro e raggio"

msgid "Center / Anchor"
msgstr "Centro / Ancoraggio"

msgid "Construction circle by center and anchor (point, line tangency, circle tangency)"
msgstr "Cerchio di costruzione per centro e ancoraggio (punto, tangente linea, tangente cerchio)"

msgid "3 Anchors"
msgstr "3 ancore"

msgid "Construction circle through 3 anchors"
msgstr "Cerchio di costruzione attraverso 3 ancore"

msgid "2 Anchors / Radius"
msgstr "2 ancore / Raggio"

msgid "Construction circle through 2 anchors with given radius"
msgstr "Cerchio di costruzione attraverso 2 ancore con raggio dato"

msgid "Start Path"
msgstr "Inizia contorno"

msgid "Close Path"
msgstr "Chiudi contorno"

msgid "End Path"
msgstr "Termina contorno"

msgid "Settings"
msgstr "Impostazioni"

msgid "Construction"
msgstr "Costruzione"

msgid "Highlight"
msgstr "Evidenziazione"

msgid "Preview"
msgstr "Anteprima"

msgid "Current path"
msgstr "Contorno corrente"

msgid "Candidate path"
msgstr "Contorno candidato"

msgid "Closed path"
msgstr "Contorno chiuso"

msgid "Color"
msgstr "Colore"

msgid "Thickness"
msgstr "Spessore"

msgid "Transparency"
msgstr "Trasparenza"
